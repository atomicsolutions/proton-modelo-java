{
  "descricao": "Compra com sucesso (API e web): consulta o CEP de entrega, põe a mochila no carrinho e conclui a compra, conferindo o preço do item no total.",
  "passos": [
    {
      "componente": "ConsultarCep",
      "parametros": {
        "in_cep": "01310-100"
      }
    },
    {
      "componente": "FazerLogin",
      "parametros": {
        "in_usuario": "standard_user",
        "in_senha": "${env:SENHA_DA_LOJA}"
      }
    },
    {
      "componente": "AdicionarAoCarrinho",
      "parametros": {
        "in_produto": "Sauce Labs Backpack"
      }
    },
    {
      "componente": "FinalizarCompra",
      "parametros": {
        "in_nome": "Ana",
        "in_sobrenome": "Souza",
        "in_cep": "${out_cep}",
        "in_preco_esperado": "${out_preco}"
      }
    }
  ]
}
